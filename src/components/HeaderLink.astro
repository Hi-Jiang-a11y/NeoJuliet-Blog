---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalizePath = (path: string) => {
	const normalized = path.replace(/\/+$/, '');
	return normalized || '/';
};

const pathname = normalizePath(Astro.url.pathname);
const targetPath = normalizePath(new URL(href || '/', Astro.url).pathname);
// Keep section links active on their nested pages too (for example, Archive
// remains active while viewing /archive/ and any future archive subpage).
const isActive = targetPath === '/'
	? pathname === '/'
	: pathname === targetPath || pathname.startsWith(`${targetPath}/`);
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
