---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
            <HeaderLink href="/">Home</HeaderLink>

            <HeaderLink href="/archive/">Archive</HeaderLink>

            <HeaderLink href="/about/">About</HeaderLink>

            <HeaderLink href="/tag/">Tags</HeaderLink>

            <HeaderLink href="/friendlink/">Links</HeaderLink>
        </div>
        <!-- 主题切换按钮 -->
        <div class="theme-switcher">
            <button id="theme-toggle" type="button" aria-label="Switch to dark mode" title="Toggle theme">🎨</button>
        </div>
    </nav>
</header>


<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		margin: 0;
		padding: 0 1em;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		transition: transform 0.24s ease, opacity 0.24s ease;
		/* Keep the original pink tint, but make it opaque so revealed text
		   cannot show through the bar. */
		background: rgb(var(--juliet-pink) / 0.14);
		backdrop-filter: none;
	}
	header.header-hidden {
		transform: translateY(-110%);
		opacity: 0;
		pointer-events: none;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
        justify-content: space-between;
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
        padding: 0em 0;
        height: auto;
		background: transparent;
	}
	nav a {
		padding: 0.5em 0.2em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
        border-bottom-color: rgb(var(--juliet-pink)/0.8);
	}
    .internal-links {
        display: flex;
        gap: 1em;
        margin-left: auto;
        margin-right: 1em;
    }
    .theme-switcher {
        position: relative;
    }
    #theme-toggle {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.2em;
        padding: 0.5em;
        color: var(--black);
    }
    :global(:root[data-theme="dark"]) #theme-toggle {
        color: rgb(var(--gray-light));
    }
    @media (max-width: 720px) {
        header {
            padding: 0 0.75rem;
        }

        nav {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            padding: 0.35rem 0;
            border-radius: 0;
            gap: 0.2rem 0.5rem;
        }

        h2 {
            min-width: 0;
            overflow: hidden;
            font-size: 1rem;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .internal-links {
            grid-column: 1 / -1;
            width: 100%;
            gap: 1rem;
            overflow-x: auto;
            scrollbar-width: none;
            margin: 0;
            padding-bottom: 0.1rem;
        }
        .internal-links::-webkit-scrollbar {
            display: none;
        }
        .theme-switcher {
            grid-column: 2;
            grid-row: 1;
        }
        #theme-toggle {
            padding: 0.25rem 0.35rem;
            min-width: 2.25rem;
            min-height: 2.25rem;
        }
        nav a {
            flex: 0 0 auto;
            padding: 0.25rem 0 0.2rem;
            font-size: 0.84rem;
            border-bottom-width: 3px;
            white-space: nowrap;
        }
    }
</style>
