---
import Layout from '../layouts/Layout.astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro'; 
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/text-effect-typing.css';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ModuleA from '../components/sidebar/moduleA.astro';
import ModuleB from '../components/sidebar/moduleB.astro';
import ModuleC from '../components/sidebar/moduleC.astro';
import RecentTimeline from '../components/RecentTimeline.astro';

type Props = CollectionEntry<'about'>;

const aboutEntries = await getCollection('about');
if (aboutEntries.length === 0) throw new Error('No about entry found!');
const post = aboutEntries[0];

const { Content, headings } = await render(post);
const { title, description, author } = post.data;

const postTitle = title || 'About Me';
const postDescription = description || 'About me page';
const postAuthor = author || 'Juliet';
const timelinePosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout rightbar={true}>
    <BaseHead slot="head" title={SITE_TITLE} description={SITE_DESCRIPTION} />

    <div slot="leftbar">
        <ModuleA />
        <ModuleB />
    </div>
    <div slot="rightbar">
        <RecentTimeline posts={timelinePosts} />
        <div class="rightbar-statistics" style="margin-top: 40px;"><ModuleC /></div>
    </div>
    <h2 id="typing" data-text="/i/nformation"></h2>

    <article class="AboutContent">
        <Content />
    </article>

</Layout>
<style is:global>
.AboutContent {
  line-height: 1.7;
  /*color: rgb(var(--gray-dark));*/
}

/*markdown content*/

/*link*/
.AboutContent a {
    color: rgb(var(--juliet-pink));
    text-decoration: none;
    font-weight: 500;
}

.AboutContent a:hover {
    color: rgb(var(--juliet-pink));
    text-decoration: underline;
}

/*blockquote*/
.AboutContent blockquote {
    border-left: 4px solid rgb(var(--juliet-hotpink));
    background: rgb(var(--juliet-pink)/0.05);
    border-radius: 2px;
    padding-left: 0.75rem 1rem;
    color: #555;
    font-style: normal;
    font-size: 1.2rem;
}

/*table*/
.AboutContent table {
    width: 100%;
    border-collapse: collapse;
}

.AboutContent th,
.AboutContent td {
    border: 1px solid #ccc;
    padding: 8px 12px;
}

.AboutContent th {
    font-weight: 600;
}

/*code block*/
.AboutContent pre {
    background: rgb(var(--juliet-palepink)/0.20) !important;
    padding: 1rem !important;
    border-radius:12px;
    overflow-x: auto;
}

.AboutContent pre code,
code[class*="language-"] {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    color: inherit !important;
}

.AboutContent pre code :not(.token) {
    color: #555 !important;
}

.AboutContent :not(pre) > code {
    background: rgba(var(--juliet-pink)/0.20);
    color: rgb(var(--juliet-hotpink)/0.7);
    padding: 3px 8px;
    border-radius: 8px;
    font-size: 0.95em;
}

.AboutContent h1 {
    font-size: 2.5rem;
}
.AboutContent h2 {
    font-size: 2.3rem;
}
.AboutContent h3 {
    font-size: 2rem;
}
.AboutContent h4 {
    font-size: 1.8rem;
}
.AboutContent h5 {
    font-size: 1.8rem;
}
.AboutContent h6 {
    font-size: 1.6rem;
}
</style>
