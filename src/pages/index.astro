---
import Layout from '../layouts/Layout.astro';
import BaseHead from '../components/BaseHead.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/blog-card.css'
import '../styles/text-effect-typing.css';
import BookIcon from '../icons/BookIcon.astro';
import ModuleA from '../components/sidebar/moduleA.astro';
import ModuleB from '../components/sidebar/moduleB.astro';
import ModuleC from '../components/sidebar/moduleC.astro';
import RecentTimeline from '../components/RecentTimeline.astro';

// max number of blogcards
const allPostsRaw = await getCollection('blog');
console.log('ALL IDS:', allPostsRaw.map(p => p.id));

const englishPosts = allPostsRaw.filter(post => {
    const id = String(post.id).replace(/^[.\/\\]+/, '').toLowerCase();
    return !id.startsWith('zh/');
});
console.log('ENGLISH IDS:', englishPosts.map(p => p.id));

const allPosts = englishPosts.sort((a, b) => {
    if (a.data.pinned && !b.data.pinned) return -1;
    if (!a.data.pinned && b.data.pinned) return 1;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

const timelinePosts = allPosts.slice(0, 8);
const posts = allPosts;
---

<Layout rightbar={true}>
    <BaseHead slot="head" title={SITE_TITLE} description={SITE_DESCRIPTION} />

    <!--左边栏-->
    <div slot="leftbar">
        <ModuleA />
        <ModuleB />
    </div>
    <div slot="rightbar">
        <RecentTimeline posts={timelinePosts} />
        <div class="rightbar-statistics" style="margin-top: 40px;"><ModuleC /></div>
    </div>
    <!--主页内容-->
    <!--打字机特效-->
    <h2 id="typing" data-text="Welcome to NeoJuliet's Site!"></h2>
        <!--简介--!>
        <p>
            What you love is your life.
        </p>

        <!--Blog Cards--!>
        <h3>Blog Posts</h3>
            {posts.map(post => (
                <article class={`blog-card ${post.data.pinned ? 'pinned' : ''}`}>
                    <h2 class="blog-title">
                        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    </h2>
                    <!--author and data--!>
                    <p class="blog-meta">
                        {post.data.author && <>By {post.data.author} - </>}
                        <FormattedDate date={post.data.pubDate} />
                    </p>

                    <!--description--!>
                    {post.data.description && (
                        <p class="blog-description">
                            <BookIcon />
                            {post.data.description}
                        </p> )}
                    <!--tags--!>
                    {post.data.tags && (
                        <div class="blog-tags">
                            {post.data.tags.map(tag => (
                            <a class="tag" href={`/tag/${tag}`}># {tag}</a> ))}
                        </div> )}
                </article> ))}

</Layout>
