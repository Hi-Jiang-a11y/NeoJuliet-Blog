---
import Layout from '../../layouts/Layout.astro';
import BaseHead from '../../components/BaseHead.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import '../../styles/text-effect-typing.css';
import '../../styles/friendlinks.css';
import ModuleA from '../../components/sidebar/moduleA.astro';
import ModuleB from '../../components/sidebar/moduleB.astro';
import ModuleC from '../../components/sidebar/moduleC.astro';
import RecentTimeline from '../../components/RecentTimeline.astro';

const links = await getCollection('friendlinks');
const timelinePosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout rightbar={true}>
    <BaseHead slot="head" title={`Friends - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />

    <!--左边栏-->
    <div slot="leftbar">
        <ModuleA />
        <ModuleB />
    </div>
    <div slot="rightbar">
        <RecentTimeline posts={timelinePosts} />
        <div class="rightbar-statistics" style="margin-top: 40px;"><ModuleC /></div>
    </div>

    <h2 id="typing" data-text="/f/riendlink"></h2>
    <!--简介-->
    <p>
        Here are the friendlinks
    </p>

    <!-- FriendLink Cards -->
    <div class="friendlinks-container">
        {links.map(({ data }) => (
            <div class="friendlink-card">
                <img src={data.avatar} alt={data.name} class="friendlink-avatar" />
                <div class="friendlink-info">
                    <h3><a href={data.url} target="_blank" rel="noopener noreferrer">{data.name}</a></h3>
                    <p>{data.description}</p>
                </div>
            </div>
        ))}
    </div>

    <div class="mylinks-container">
        <h1>Exchange Links</h1>
        <p>Welcome! Contact me via <a href="mailto:neojuliett1984@outlook.com" target="_blank" rel="noopener noreferrer">email</a></p>
        <ul>
            <li>Name: NeoJuliet</li>
            <li>URL: https://neojulietblog.netlify.app/</li>
            <li>Avatar: https://neojulietblog.netlify.app/images/avatar.JPG/</li>
            <li>Description: 似乎来到了没有知识存在的荒原？？</li>
        </ul>

    </div>

</Layout>
